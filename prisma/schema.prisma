// SchoolVerse data model.
//
// Tenancy: every customer-owned record hangs off an Organisation. Records that
// are queried directly by id (schools, assets, faults, network nodes) also carry
// `organisationId` so every query can be scoped with a single indexed filter.
// The application never loads a record by id alone — see src/lib/tenant.ts.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ─── Enums ────────────────────────────────────────────────────────────────

enum Role {
  OWNER
  ADMIN
  TECHNICIAN
  VIEWER
}

enum RoomType {
  CLASSROOM
  OFFICE
  IT_SUITE
  SERVER_ROOM
  COMMS_CABINET
  HALL
  LIBRARY
  STAFFROOM
  CORRIDOR
  STAIRS
  LIFT
  OTHER
}

enum AssetType {
  DESKTOP
  LAPTOP
  CHROMEBOOK
  TABLET
  PRINTER
  PROJECTOR
  INTERACTIVE_DISPLAY
  ACCESS_POINT
  SWITCH
  ROUTER
  FIREWALL
  SERVER
  NAS
  UPS
  PHONE
  CAMERA
  CABINET
  TROLLEY
  OTHER
}

enum AssetStatus {
  ACTIVE
  IN_REPAIR
  IN_STORAGE
  RETIRED
}

enum FaultPriority {
  LOW
  MEDIUM
  HIGH
  CRITICAL
}

enum FaultStatus {
  OPEN
  IN_PROGRESS
  ON_HOLD
  RESOLVED
  CLOSED
}

enum FaultUpdateKind {
  COMMENT
  STATUS_CHANGE
  FIX
}

enum NetworkNodeType {
  INTERNET
  WAN_LINK
  ROUTER
  FIREWALL
  CORE_SWITCH
  SWITCH
  SERVER
  ACCESS_POINT
  SERVICE
  UPS
  OTHER
}

enum CableType {
  CAT5E
  CAT6
  CAT6A
  CAT7
  FIBRE_SM
  FIBRE_MM
  COAX
  OTHER
}

enum LinkKind {
  PRIMARY
  REDUNDANT
}

// ─── Identity & tenancy ───────────────────────────────────────────────────

model User {
  id           String   @id @default(cuid())
  email        String   @unique
  name         String
  passwordHash String
  isDemo       Boolean  @default(false)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  memberships        Membership[]
  sessions           Session[]
  passwordResets     PasswordResetToken[]
  invitationsSent    Invitation[]        @relation("InvitedBy")
  faultsReported     Fault[]             @relation("FaultReporter")
  faultsAssigned     Fault[]             @relation("FaultAssignee")
  faultUpdates       FaultUpdate[]
  maintenanceRecords MaintenanceRecord[]
  assetPhotos        AssetPhoto[]
  simulationRuns     SimulationRun[]
  auditLogs          AuditLog[]
}

model Organisation {
  id        String   @id @default(cuid())
  name      String
  slug      String   @unique
  isDemo    Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  memberships    Membership[]
  invitations    Invitation[]
  schools        School[]
  assets         Asset[]
  faults         Fault[]
  networkNodes   NetworkNode[]
  simulationRuns SimulationRun[]
  auditLogs      AuditLog[]
  sessions       Session[]
  cableRuns      CableRun[]
}

model Membership {
  id             String   @id @default(cuid())
  userId         String
  organisationId String
  role           Role     @default(VIEWER)
  createdAt      DateTime @default(now())

  user         User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  organisation Organisation @relation(fields: [organisationId], references: [id], onDelete: Cascade)

  @@unique([userId, organisationId])
  @@index([organisationId])
}

model Invitation {
  id             String    @id @default(cuid())
  organisationId String
  email          String
  role           Role      @default(TECHNICIAN)
  tokenHash      String    @unique
  invitedById    String?
  expiresAt      DateTime
  acceptedAt     DateTime?
  createdAt      DateTime  @default(now())

  organisation Organisation @relation(fields: [organisationId], references: [id], onDelete: Cascade)
  invitedBy    User?        @relation("InvitedBy", fields: [invitedById], references: [id], onDelete: SetNull)

  @@index([organisationId])
}

model Session {
  id             String   @id @default(cuid())
  tokenHash      String   @unique
  userId         String
  organisationId String?
  expiresAt      DateTime
  userAgent      String?
  ipAddress      String?
  createdAt      DateTime @default(now())
  lastSeenAt     DateTime @default(now())

  user         User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  organisation Organisation? @relation(fields: [organisationId], references: [id], onDelete: SetNull)

  @@index([userId])
  @@index([expiresAt])
}

model PasswordResetToken {
  id        String    @id @default(cuid())
  userId    String
  tokenHash String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

// ─── Estate ───────────────────────────────────────────────────────────────

model School {
  id             String   @id @default(cuid())
  organisationId String
  name           String
  code           String?
  phase          String?
  address        String?
  postcode       String?
  phone          String?
  contactName    String?
  contactEmail   String?
  pupilCount     Int?
  staffCount     Int?
  notes          String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  organisation   Organisation    @relation(fields: [organisationId], references: [id], onDelete: Cascade)
  buildings      Building[]
  rooms          Room[]
  assets         Asset[]
  faults         Fault[]
  networkNodes   NetworkNode[]
  networkLinks   NetworkLink[]
  simulationRuns SimulationRun[]
  cableRuns      CableRun[]

  @@index([organisationId])
}

model Building {
  id          String   @id @default(cuid())
  schoolId    String
  name        String
  description String?
  sortOrder   Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  school School  @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  floors Floor[]

  @@index([schoolId])
}

model Floor {
  id            String   @id @default(cuid())
  buildingId    String
  name          String
  level         Int      @default(0)
  // Private object-storage key of an uploaded floor plan (Phase 3).
  planImageKey  String?
  planWidth     Int      @default(1200)
  planHeight    Int      @default(800)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  building  Building   @relation(fields: [buildingId], references: [id], onDelete: Cascade)
  rooms     Room[]
  cableRuns CableRun[]

  @@index([buildingId])
}

model Room {
  id        String   @id @default(cuid())
  schoolId  String
  floorId   String
  name      String
  type      RoomType @default(CLASSROOM)
  capacity  Int?
  // Map geometry in floor-plan pixels (Phase 3 drawing tools).
  x         Float    @default(40)
  y         Float    @default(40)
  width     Float    @default(160)
  height    Float    @default(120)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  school       School        @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  floor        Floor         @relation(fields: [floorId], references: [id], onDelete: Cascade)
  assets       Asset[]
  faults       Fault[]
  networkNodes NetworkNode[]
  cablesFrom   CableRun[]    @relation("CableFrom")
  cablesTo     CableRun[]    @relation("CableTo")

  @@index([schoolId])
  @@index([floorId])
}

// ─── Assets ───────────────────────────────────────────────────────────────

model Asset {
  id             String      @id @default(cuid())
  organisationId String
  schoolId       String
  roomId         String?
  type           AssetType
  name           String
  assetTag       String
  manufacturer   String?
  model          String?
  serialNumber   String?
  ipAddress      String?
  macAddress     String?
  assignedTo     String?
  status         AssetStatus @default(ACTIVE)
  purchaseDate   DateTime?
  warrantyExpiry DateTime?
  purchaseCost   Decimal?    @db.Decimal(10, 2)
  notes          String?
  // Position within its room on the floor plan, relative to the room's
  // top-left corner (20 units = 1 m). Used for access points and cabinets;
  // other devices are laid out inside their room automatically.
  mapX           Float?
  mapY           Float?
  // Storage: the cabinet or trolley this device is kept in (cabinetId). In a
  // cabinet, rackPosition/rackUnits are its lowest U and height. For a CABINET
  // rackUnits is its total size; for a TROLLEY it's the number of bays.
  cabinetId      String?
  rackPosition   Int?
  rackUnits      Int?
  // Unguessable token encoded in printed QR labels (Phase 4).
  qrToken        String      @unique @default(cuid())
  createdAt      DateTime    @default(now())
  updatedAt      DateTime    @updatedAt

  organisation       Organisation        @relation(fields: [organisationId], references: [id], onDelete: Cascade)
  school             School              @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  room               Room?               @relation(fields: [roomId], references: [id], onDelete: SetNull)
  cabinet            Asset?              @relation("CabinetContents", fields: [cabinetId], references: [id], onDelete: SetNull)
  contents           Asset[]             @relation("CabinetContents")
  photos             AssetPhoto[]
  faults             Fault[]
  maintenanceRecords MaintenanceRecord[]
  networkNodes       NetworkNode[]

  @@unique([organisationId, assetTag])
  @@index([organisationId, schoolId])
  @@index([roomId])
  @@index([cabinetId])
  @@index([warrantyExpiry])
}

model AssetPhoto {
  id           String   @id @default(cuid())
  assetId      String
  storageKey   String   @unique
  filename     String
  contentType  String
  sizeBytes    Int
  uploadedById String?
  createdAt    DateTime @default(now())

  asset      Asset @relation(fields: [assetId], references: [id], onDelete: Cascade)
  uploadedBy User? @relation(fields: [uploadedById], references: [id], onDelete: SetNull)

  @@index([assetId])
}

model MaintenanceRecord {
  id            String   @id @default(cuid())
  assetId       String
  performedById String?
  performedAt   DateTime @default(now())
  description   String
  createdAt     DateTime @default(now())

  asset       Asset @relation(fields: [assetId], references: [id], onDelete: Cascade)
  performedBy User? @relation(fields: [performedById], references: [id], onDelete: SetNull)

  @@index([assetId])
}

// ─── Faults ───────────────────────────────────────────────────────────────

model Fault {
  id             String        @id @default(cuid())
  organisationId String
  schoolId       String
  assetId        String?
  roomId         String?
  reference      Int           @default(autoincrement())
  title          String
  description    String?
  priority       FaultPriority @default(MEDIUM)
  status         FaultStatus   @default(OPEN)
  reportedById   String?
  assignedToId   String?
  resolution     String?
  resolvedAt     DateTime?
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt

  organisation Organisation  @relation(fields: [organisationId], references: [id], onDelete: Cascade)
  school       School        @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  asset        Asset?        @relation(fields: [assetId], references: [id], onDelete: SetNull)
  room         Room?         @relation(fields: [roomId], references: [id], onDelete: SetNull)
  reportedBy   User?         @relation("FaultReporter", fields: [reportedById], references: [id], onDelete: SetNull)
  assignedTo   User?         @relation("FaultAssignee", fields: [assignedToId], references: [id], onDelete: SetNull)
  updates      FaultUpdate[]

  @@index([organisationId, status])
  @@index([schoolId])
  @@index([assetId])
}

model FaultUpdate {
  id         String          @id @default(cuid())
  faultId    String
  authorId   String?
  kind       FaultUpdateKind @default(COMMENT)
  message    String
  fromStatus FaultStatus?
  toStatus   FaultStatus?
  createdAt  DateTime        @default(now())

  fault  Fault @relation(fields: [faultId], references: [id], onDelete: Cascade)
  author User? @relation(fields: [authorId], references: [id], onDelete: SetNull)

  @@index([faultId])
}

// ─── Cabling ──────────────────────────────────────────────────────────────

// A physical cable route drawn on one floor. `points` is an ordered list of
// {x, y} map coordinates (20 units = 1 m). The rooms at each end are worked
// out from the first and last points when the run is saved.
model CableRun {
  id             String    @id @default(cuid())
  organisationId String
  schoolId       String
  floorId        String
  name           String
  type           CableType @default(CAT6)
  points         Json
  lengthMetres   Float     @default(0)
  fromRoomId     String?
  toRoomId       String?
  notes          String?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  organisation Organisation @relation(fields: [organisationId], references: [id], onDelete: Cascade)
  school       School       @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  floor        Floor        @relation(fields: [floorId], references: [id], onDelete: Cascade)
  fromRoom     Room?        @relation("CableFrom", fields: [fromRoomId], references: [id], onDelete: SetNull)
  toRoom       Room?        @relation("CableTo", fields: [toRoomId], references: [id], onDelete: SetNull)

  @@index([organisationId, schoolId])
  @@index([floorId])
}

// ─── Network & simulation ─────────────────────────────────────────────────

model NetworkNode {
  id             String          @id @default(cuid())
  organisationId String
  schoolId       String
  type           NetworkNodeType
  label          String
  assetId        String?
  roomId         String?
  // Estimated number of people who rely on this component directly.
  usersServed    Int             @default(0)
  // 1 (low) – 5 (critical): used to rank restoration priority.
  criticality    Int             @default(3)
  posX           Float           @default(0)
  posY           Float           @default(0)
  notes          String?
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt

  organisation Organisation  @relation(fields: [organisationId], references: [id], onDelete: Cascade)
  school       School        @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  asset        Asset?        @relation(fields: [assetId], references: [id], onDelete: SetNull)
  room         Room?         @relation(fields: [roomId], references: [id], onDelete: SetNull)
  outgoing     NetworkLink[] @relation("LinkSource")
  incoming     NetworkLink[] @relation("LinkTarget")

  @@index([organisationId, schoolId])
}

// A directional dependency: `target` depends on `source` (traffic flows
// source → target). A node stays up while at least one healthy upstream link
// remains, which is how redundant paths are modelled.
model NetworkLink {
  id        String   @id @default(cuid())
  schoolId  String
  sourceId  String
  targetId  String
  kind      LinkKind @default(PRIMARY)
  label     String?
  createdAt DateTime @default(now())

  school School      @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  source NetworkNode @relation("LinkSource", fields: [sourceId], references: [id], onDelete: Cascade)
  target NetworkNode @relation("LinkTarget", fields: [targetId], references: [id], onDelete: Cascade)

  @@unique([sourceId, targetId])
  @@index([schoolId])
}

model SimulationRun {
  id             String   @id @default(cuid())
  organisationId String
  schoolId       String
  failedNodeIds  String[]
  result         Json
  createdById    String?
  createdAt      DateTime @default(now())

  organisation Organisation @relation(fields: [organisationId], references: [id], onDelete: Cascade)
  school       School       @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  createdBy    User?        @relation(fields: [createdById], references: [id], onDelete: SetNull)

  @@index([organisationId, schoolId])
}

// ─── Audit ────────────────────────────────────────────────────────────────

model AuditLog {
  id             String   @id @default(cuid())
  organisationId String
  userId         String?
  action         String
  entityType     String
  entityId       String?
  summary        String
  metadata       Json?
  createdAt      DateTime @default(now())

  organisation Organisation @relation(fields: [organisationId], references: [id], onDelete: Cascade)
  user         User?        @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([organisationId, createdAt])
}
