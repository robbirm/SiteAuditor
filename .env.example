# Copy to .env for local testing (never upload .env anywhere public).
# On Hostinger, set these as environment variables in the Node.js app settings instead.
PORT=3000
# TRUST_PROXY=1
# How long full results stay on the server (default 10080 = 7 days). The History list keeps a summary of each audit for longer.
# RESULT_TTL_MINUTES=10080
# How many full audits to keep on disk at once (default 10, max 50)
# MAX_SAVED_CRAWLS=10
# Crawling time allowed per audit (time while the server was stopped doesn't count)
# MAX_CRAWL_MINUTES=20
# While a crawl runs the server pings its own public address so the host doesn't put it to sleep.
# Set this if the dashboard is opened on a different address than the public one; KEEP_AWAKE=0 turns the ping off.
# PUBLIC_URL=https://audit.example.com
# KEEP_AWAKE=1
# Where crawl results are saved while they are kept (default: ./data, falls back to the system temp folder).
# DATA_DIR=/home/youruser/site-auditor-data

# Max images whose file size is checked per audit (default 150)
#IMAGE_CHECK_LIMIT=150
